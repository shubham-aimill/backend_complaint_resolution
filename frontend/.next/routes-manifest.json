{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/claims/[claimId]",
      "regex": "^/api/claims/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPclaimId": "nxtPclaimId"
      },
      "namedRegex": "^/api/claims/(?<nxtPclaimId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/complaints/[id]/status",
      "regex": "^/api/complaints/([^/]+?)/status(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/complaints/(?<nxtPid>[^/]+?)/status(?:/)?$"
    },
    {
